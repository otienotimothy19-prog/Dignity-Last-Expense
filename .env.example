DATABASE_URL="postgresql://user:password@localhost:5432/lastexpense?schema=public"
AUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
TZ="Africa/Nairobi"

# Used to build the QR-code verify link embedded in quotation/policy PDFs.
# Must be reachable from whatever device scans the QR code — "localhost"
# only means "this device." Use the deployed domain in production, or this
# machine's LAN IP (find it with `ipconfig`) for local phone testing.
APP_URL="http://localhost:3000"

# Zoho Mail SMTP — required for real quotation/policy email sending.
# Host: smtppro.zoho.com for Zoho Workplace/Pro orgs, smtp.zoho.com for plain
# Zoho Mail (confirm from Mail Settings > Configurations in the Zoho admin
# console). ZOHO_SMTP_USER is the full mailbox address.
# ZOHO_SMTP_PASSWORD is an app-specific password from
# https://accounts.zoho.com/home#security/app_password — not the account's
# normal login password.
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASSWORD=""
MAIL_FROM="Imoth Insurance Brokers <insurance@imoth.co.ke>"
